# Named journey-portal deployment configuration. Copy to .env and replace every REPLACE_ME value.
# This file contains no secret values. Secrets belong only in .env.secrets.

GCP_PROJECT_ID=REPLACE_ME_GCP_PROJECT_ID
GCP_REGION=asia-southeast1
GCP_ALLOWED_REGIONS_JSON=["asia-southeast1"]
DEPLOY_NAME_PREFIX=hrz9

# Current and all 17 rollback images must be independently reviewed immutable digests. Verify
# registry retention separately; declaring a digest here does not keep it pullable.
DEPLOY_BFF_IMAGE=asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/portal/bff@sha256:REPLACE_ME
DEPLOY_RM_SHELL_IMAGE=asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/portal/rm@sha256:REPLACE_ME
DEPLOY_OPS_SHELL_IMAGE=asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/portal/ops@sha256:REPLACE_ME
DEPLOY_ROLLBACK_IMAGES_JSON={"bff":"REPLACE_ME@sha256:REPLACE_ME","rm":"REPLACE_ME@sha256:REPLACE_ME","ops":"REPLACE_ME@sha256:REPLACE_ME","cdd-sow-research-ui":"REPLACE_ME@sha256:REPLACE_ME","cdd-sow-research-api":"REPLACE_ME@sha256:REPLACE_ME","credit-memo-drafting-ui":"REPLACE_ME@sha256:REPLACE_ME","credit-memo-drafting-api":"REPLACE_ME@sha256:REPLACE_ME","cio-advisory-ui":"REPLACE_ME@sha256:REPLACE_ME","cio-advisory-api":"REPLACE_ME@sha256:REPLACE_ME","trade-finance-checker-ui":"REPLACE_ME@sha256:REPLACE_ME","trade-finance-checker-api":"REPLACE_ME@sha256:REPLACE_ME","loan-document-intelligence-ui":"REPLACE_ME@sha256:REPLACE_ME","loan-document-intelligence-api":"REPLACE_ME@sha256:REPLACE_ME","compliance-advisory-ui":"REPLACE_ME@sha256:REPLACE_ME","compliance-advisory-api":"REPLACE_ME@sha256:REPLACE_ME","human-review-console-ui":"REPLACE_ME@sha256:REPLACE_ME","human-review-console-api":"REPLACE_ME@sha256:REPLACE_ME"}

# Include all seven launch-journey apps. Secret values are never placed here. The ui_secret_env
# and api_secret_env maps hold Secret Manager secret names only.
DEPLOY_EMBEDDED_APPS_JSON={"cdd-sow-research":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc1-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc1-api@sha256:REPLACE_ME","ui_build_base_path":"/agent","api_env":{"CDD_PROFILE":"gcp","CDD_IDENTITY_PROFILE":"iap","CDD_CHANNEL_PROFILE":"native"}},"credit-memo-drafting":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc2-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc2-api@sha256:REPLACE_ME","ui_build_base_path":"/apps/credit-memo-drafting","api_env":{"CREDIT_MEMO_PROFILE":"gcp"}},"cio-advisory":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc3-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc3-api@sha256:REPLACE_ME","ui_build_base_path":"/apps/cio-advisory","api_env":{"CIO_PROFILE":"gcp"}},"trade-finance-checker":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc4-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc4-api@sha256:REPLACE_ME","ui_build_base_path":"/apps/trade-finance-checker","api_env":{"TRADE_FINANCE_PROFILE":"gcp"}},"loan-document-intelligence":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc5-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/doc5-api@sha256:REPLACE_ME","ui_build_base_path":"/apps/loan-document-intelligence","api_env":{"LOAN_DOC_PROFILE":"gcp"}},"compliance-advisory":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/rsk1-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/rsk1-api@sha256:REPLACE_ME","ui_build_base_path":"/apps/compliance-advisory","api_env":{"COMPLIANCE_PROFILE":"gcp"}},"human-review-console":{"ui_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/hrz7-ui@sha256:REPLACE_ME","api_image":"asia-southeast1-docker.pkg.dev/REPLACE_ME_GCP_PROJECT_ID/apps/hrz7-api@sha256:REPLACE_ME","ui_build_base_path":"/apps/human-review-console","api_env":{"REVIEW_PROFILE":"gcp"}}}

DEPLOY_RM_DOMAIN=REPLACE_ME_RM_DOMAIN
DEPLOY_OPS_DOMAIN=REPLACE_ME_OPS_DOMAIN
DEPLOY_TENANT_ID=REPLACE_ME_STABLE_TENANT_ID
# The VERIFIED identity domains that belong to that tenant. The tenant id above is a label this
# deployment chooses; the identity layer only ever sees the domain on the assertion, so without
# this map the two are unrelated strings and the host/tenant check denies every request.
DEPLOY_TENANT_IDENTITY_DOMAINS_JSON=["REPLACE_ME_IDENTITY_DOMAIN"]
DEPLOY_OBSERVABILITY_URL=https://REPLACE_ME_OBSERVABILITY_SERVICE
DEPLOY_OBSERVABILITY_AUDIENCE=https://REPLACE_ME_OBSERVABILITY_AUDIENCE
DEPLOY_DNS_MANAGED_ZONE=REPLACE_ME_DNS_ZONE
DEPLOY_TLS_MODE=google-managed
DEPLOY_IAP_OAUTH_CLIENT_ID=REPLACE_ME_IAP_CLIENT_ID
# Secret Manager resource name and exact numeric version containing a random 32-byte-or-longer
# HMAC key. The value is mounted only into the BFF and never enters Terraform state.
DEPLOY_PORTAL_AUDIT_HMAC_SECRET=REPLACE_ME_PORTAL_AUDIT_HMAC_SECRET
DEPLOY_PORTAL_AUDIT_HMAC_SECRET_VERSION=REPLACE_ME_NUMERIC_SECRET_VERSION
# Bootstrap only: keep both audience and members empty. After stage one, copy the exact output
# audience and add approved members before stage two.
DEPLOY_IAP_JWT_AUDIENCE=
DEPLOY_IAP_MEMBERS_JSON=[]
DEPLOY_FRAME_ANCESTORS_JSON=["'self'","https://REPLACE_ME_PARENT_ORIGIN"]
DEPLOY_CORS_ORIGINS_JSON=[]

# Existing Monitoring notification-channel resource names.
DEPLOY_NOTIFICATION_CHANNELS_JSON=["projects/REPLACE_ME_GCP_PROJECT_ID/notificationChannels/REPLACE_ME"]

# Destructive or organization-wide controls remain opt-in.
DEPLOY_APPLY_ORG_POLICIES=false
DEPLOY_VPC_SC_ACCESS_POLICY_ID=REPLACE_ME_ACCESS_POLICY_ID
DEPLOY_VPC_SC_ENFORCED=false
DEPLOY_CMEK_ROTATION_PERIOD=7776000s
DEPLOY_AUDIT_RETENTION_DAYS=180
DEPLOY_LOCK_AUDIT_BUCKET=false
# Cloud Run deletion protection. True for anything that matters; false while a deployment is
# still churning images, because a protected service refuses the replacement mid-apply. It lives
# here rather than in the generated tfvars because that file is regenerated by `render`, so a
# value hand-edited into it survives exactly until the next render and then silently reverts.
DEPLOY_CLOUD_RUN_DELETION_PROTECTION=true

# The deployment's standing spend, stated rather than inherited. These three are required for
# the same reason the audit lock next door is: a control with no deployment surface is a
# control nobody chooses, and the fleet already has one irreversible seven-year bucket that
# was acquired because a tfvars said nothing.
#
# Warm instances per service. This stack runs FIVE services, so 1 is five instances billed
# around the clock -- the deployment's dominant idle cost. 0 means cold starts on the first
# request after an idle period: right for a reference deployment, wrong for a demonstration
# you are about to give, and wrong for a service whose callers fail closed while it wakes.
DEPLOY_RUN_MIN_INSTANCES=1
# Fraction of load-balancer requests logged, per backend, across three backends. 1 logs every
# request into a CMEK-encrypted retained bucket. Keep 1 where the access log is evidence.
DEPLOY_LB_LOG_SAMPLE_RATE=1
# ALL, ERRORS_ONLY or TRANSLATIONS_ONLY. ERRORS_ONLY keeps the connection that failed, which
# is what a NAT log is usually opened for, and drops the successful-translation volume. Keep
# ALL where egress translations are themselves the evidence.
DEPLOY_NAT_LOG_FILTER=ALL

DEPLOY_TERRAFORM_STATE_BUCKET=REPLACE_ME_TERRAFORM_STATE_BUCKET
DEPLOY_TERRAFORM_STATE_PREFIX=hrz9/REPLACE_ME_ENVIRONMENT

DEPLOYMENT_OWNER=REPLACE_ME_DEPLOYMENT_OWNER
SECURITY_OWNER=REPLACE_ME_SECURITY_OWNER
DNS_IAP_OWNER=REPLACE_ME_DNS_IAP_OWNER
OPERATIONS_OWNER=REPLACE_ME_OPERATIONS_OWNER
EVIDENCE_APPROVER=REPLACE_ME_EVIDENCE_APPROVER

# Local runtime remains offline unless explicitly changed. These values do not drive Terraform.
# PORTAL_PROFILE has no default: leaving it unset is treated as "nobody chose a posture" and the
# portal refuses to serve rather than inheriting the local relaxations. Name it deliberately.
PORTAL_PROFILE=local
PORTAL_JOURNEYS=config/journeys.yaml
PORTAL_ALLOW_INSECURE_DEMO=0

# ---------------------------------------------------------------------------
# cdd-sow-research Mode 5 brokered grant: the portal's BFF service identity and registration.
# ALL-OR-NOTHING. An journey-portal deployment that fronts no cdd-sow-research Mode 5 installation leaves every
# variable below unset and the preflight is satisfied. Name ANY one of them and the preflight
# demands all of them plus PORTAL_SESSION_SIGNING_KEY in .env.secrets, because a half-configured
# registration is what authenticates to an unreviewed endpoint under an unreviewed client.
# Fill them from docs/named-deployment-dossier.md, which records what is still PENDING.
#
# PORTAL_PUBLIC_ORIGIN=https://REPLACE_ME_PORTAL_ORIGIN
# PORTAL_DOC1_GRANT_ENDPOINT=https://REPLACE_ME_DOC1_HOST/agent/api/v1/embed/grants
# PORTAL_DOC1_INSTALLATION_ID=REPLACE_ME_INSTALLATION_ID
# PORTAL_DOC1_BFF_CLIENT_ID=REPLACE_ME_BFF_CLIENT_ID
# The signing key is a NON-EXPORTABLE Cloud KMS key version: the deployment names the version,
# never the key material. The kid is what the published JWK set and every assertion header carry.
# PORTAL_BFF_SIGNING_KEY_VERSION=projects/REPLACE_ME/locations/asia-southeast1/keyRings/REPLACE_ME/cryptoKeys/REPLACE_ME/cryptoKeyVersions/1
# PORTAL_BFF_SIGNING_KID=REPLACE_ME_KEY_ID
# Optional, and only during a rotation: the previous public JWK stays published so in-flight
# assertions still verify inside the reviewed overlap window.
# PORTAL_BFF_ACCEPTED_PUBLIC_JWKS=[]
# Optional: the reviewed default is cdd.embed,cdd.read. Set it to narrow, never to widen (cdd-sow-research
# intersects with the installation's and the BFF client's permitted sets regardless).
# PORTAL_DOC1_REQUESTED_SCOPES=cdd.embed,cdd.read
