{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2021"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-mkt/types/**/*.ts",
    ".next-mkt/dev/types/**/*.ts",
    ".next-gov/types/**/*.ts",
    ".next-gov/dev/types/**/*.ts",
    ".next-svc/types/**/*.ts",
    ".next-svc/dev/types/**/*.ts",
    ".next-rm/types/**/*.ts",
    ".next-rm/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
