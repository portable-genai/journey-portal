# Copy to .env.secrets, then chmod 600 .env.secrets. Never commit or log the copied file.
DEPLOY_IAP_OAUTH_CLIENT_SECRET=REPLACE_ME_IAP_CLIENT_SECRET

# Required only when the Doc1 Mode 5 registration in .env is configured. It keys the CSRF tokens
# and the hashed session binding the host authorization proof carries, so it must come from
# Secret Manager and must survive a restart: an improvised per-process key would invalidate every
# outstanding CSRF token on every deploy. The BFF SIGNING key is never here; it is a
# non-exportable Cloud KMS key version named in .env.
# PORTAL_SESSION_SIGNING_KEY=REPLACE_ME_PORTAL_SESSION_SIGNING_KEY
