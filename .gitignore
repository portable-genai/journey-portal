# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.Python

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Node shells (ui-rm/, ui-ops/)
ui-rm/node_modules/
ui-rm/.next/
# One build directory per journey. The shell bakes its journey name in at build time, so a
# journey is a separate build of the same codebase and they cannot share output.
ui-rm/.next-*/
# Regenerated by Next against whichever build directory ran last, so it churns between
# journeys. Generated, never authored.
ui-rm/next-env.d.ts
ui-rm/out/
ui-ops/node_modules/
ui-ops/dist/
ui-ops/.angular/
ui-ops/out-tsc/

# Demo output
scripts/out/
.local/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
infra/terraform/*.tfplan.integrity.json
infra/terraform/*.auto.tfvars
infra/terraform/.generated.tfvars.json

# Secrets / local env - never commit
*.env
.env
.env.*
!.env.example
!.env.secrets.example
*-key.json
*.pem
service-account*.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Completed deployment dossiers: real institution values, never tracked
*.local.md
e2e/out/

# Next.js 16 writes these agent-rule files into each UI directory during a build. They are
# generated, not authored here, and an untracked pair after every `--built` run is what makes
# the portfolio gate report this tree as dirty for no change anyone made.
ui-*/AGENTS.md
ui-*/CLAUDE.md
